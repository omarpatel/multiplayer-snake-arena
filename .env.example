# Game server (npm run server)
PORT=3001
# Origin allowed by the game server CORS policy (the Next.js app)
APP_URL=http://localhost:3000
# Seconds a lobby waits for humans before filling empty seats with bots
BOT_FILL_SECONDS=10

# Next.js app (npm run dev): where the browser finds the game server
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
